PROJECT_NAME="Mayur Sawant Portfolio API"
ENVIRONMENT="development"
PORT=8000
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://mayursawant.dev"

# Database: Neon PostgreSQL connection string
# Format: postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL="postgresql://neondb_owner:your_password@ep-your-endpoint.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Security & JWT
SECRET_KEY="supersecretjwtkey-change-this-in-production-use-a-strong-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin User (auto-seeded on startup if not present)
INITIAL_ADMIN_EMAIL="mayursawant0517@gmail.com"
INITIAL_ADMIN_PASSWORD="ChangeMeAdmin123!"

# Email (Resend)
RESEND_API_KEY=""
OWNER_EMAIL="mayursawant0517@gmail.com"
EMAIL_FROM_NAME="Mayur Sawant"
EMAIL_FROM_ADDRESS="onboarding@resend.dev"
